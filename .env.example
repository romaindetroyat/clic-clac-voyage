# Copier en .env.local pour le développement. NE JAMAIS COMMITER DE VRAIES VALEURS.
# En production, ces variables se règlent dans Vercel (Settings > Environment Variables).

# URL publique de l'app, sans barre finale. Sert aux liens d'invitation, liens secrets, e-mails.
# Laisser vide sur Vercel pour utiliser automatiquement l'URL de production du projet.
APP_URL=http://localhost:3000

# Postgres Neon (créé par l'intégration Vercel), ou une base embarquée pour le développement :
DATABASE_URL=pglite:.data/dev

# Secret de signature des sessions : 32 caractères au moins. Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=

# Adresses autorisées à se connecter sans invitation (créateurs de voyages), séparées par des virgules.
ADMIN_EMAILS=

# E-mails, option 1 (recommandée sans domaine) : Gmail.
# Mot de passe d'application : https://myaccount.google.com/apppasswords (validation en deux étapes requise).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# E-mails, option 2 : Resend, avec un domaine d'envoi vérifié.
RESEND_API_KEY=
EMAIL_FROM=
# En développement, écrire les e-mails dans un fichier au lieu de les envoyer :
MAIL_OUTBOX_FILE=.data/outbox.jsonl

# Connexion Google (facultatif)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
